{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_output.schema.json",
  "title": "ResearchOutput",
  "description": "The output fields of Phase 1 (saved inside PhaseResult.fields). Each agent's section is refined by its owner after the agent design is decided in the spec.",
  "type": "object",
  "required": ["site_analysis", "market", "gaps", "segments", "competitors", "supervisor_review", "recommended_business_types"],
  "additionalProperties": false,
  "properties": {
    "site_analysis": { "$ref": "#/$defs/AgentOutput" },
    "market": { "$ref": "#/$defs/AgentOutput" },
    "gaps": { "$ref": "#/$defs/AgentOutput" },
    "segments": { "$ref": "#/$defs/AgentOutput" },
    "competitors": { "$ref": "#/$defs/AgentOutput" },
    "supervisor_review": { "$ref": "#/$defs/SupervisorReview" },
    "recommended_business_types": { "type": "array", "items": { "$ref": "#/$defs/RecommendedBusinessType" } }
  },
  "$defs": {
    "AgentOutput": {
      "type": "object",
      "required": ["summary", "facts"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "description": "Short text for the summary card; every claim in it is backed by a fact below." },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } }
      }
    },
    "SupervisorReview": {
      "type": "object",
      "required": ["decision", "rounds", "open_issues"],
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string", "enum": ["finish", "rerun", "escalate"] },
        "rounds": { "type": "integer", "minimum": 0, "maximum": 2, "description": "Rerun rounds used (stop rule: 2)." },
        "open_issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RecommendedBusinessType": {
      "type": "object",
      "required": ["business_type", "origin", "reason", "evidence"],
      "additionalProperties": false,
      "properties": {
        "business_type": { "type": "string" },
        "origin": { "type": "string", "enum": ["user", "research"] },
        "reason": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Fact" } }
      }
    },
    "Evidence": {
      "type": "object",
      "description": "Where one fact came from. A fact is never estimated by an LLM.",
      "required": ["fact_type", "source", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "fact_type": { "type": "string", "enum": ["computable", "retrieved", "expert"] },
        "source": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["url", "api", "function", "escalation"] },
            "ref": { "type": "string", "description": "The URL, the API + query, the function name, or the escalation_id." },
            "title": { "type": "string", "description": "Human-readable source name for the Sources tab." }
          }
        },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    },
    "Fact": {
      "type": "object",
      "description": "One fact and its evidence.",
      "required": ["label", "value", "evidence"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "What the fact is, e.g. 'nearest main road'." },
        "value": true,
        "unit": { "type": "string" },
        "evidence": { "$ref": "#/$defs/Evidence" }
      }
    }
  }
}
